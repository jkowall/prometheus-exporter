# HELP spacelift_public_worker_pool_schedulable_runs The number of runs waiting for or executing on a worker in the public worker pool for this account, by the run's state and type; partial when spacelift_public_worker_pool_schedulable_runs_truncated is 1
# TYPE spacelift_public_worker_pool_schedulable_runs gauge
spacelift_public_worker_pool_schedulable_runs{state="INITIALIZING",type="PROPOSED"} 1
spacelift_public_worker_pool_schedulable_runs{state="READY",type="TRACKED"} 1
# HELP spacelift_public_worker_pool_schedulable_runs_truncated Whether the search returned only some of the schedulable runs in the public worker pool for this account (1), so the by-state counts are partial, or all of them (0)
# TYPE spacelift_public_worker_pool_schedulable_runs_truncated gauge
spacelift_public_worker_pool_schedulable_runs_truncated 0
# HELP spacelift_worker_pool_schedulable_runs The number of runs waiting for or executing on a worker in a worker pool, by the run's state and type; partial when spacelift_worker_pool_schedulable_runs_truncated is 1
# TYPE spacelift_worker_pool_schedulable_runs gauge
spacelift_worker_pool_schedulable_runs{state="PLANNING",type="TRACKED",worker_pool_id="01HQZX9K7P2M3N4Q5R6S7T8U9V",worker_pool_name="production"} 1
spacelift_worker_pool_schedulable_runs{state="READY",type="PROPOSED",worker_pool_id="01HQZX9K7P2M3N4Q5R6S7T8U9V",worker_pool_name="production"} 2
spacelift_worker_pool_schedulable_runs{state="READY",type="TRACKED",worker_pool_id="01HQZX9K7P2M3N4Q5R6S7T8U9V",worker_pool_name="production"} 1
spacelift_worker_pool_schedulable_runs{state="READY",type="TRACKED",worker_pool_id="01HQZXA1B2C3D4E5F6G7H8J9K0",worker_pool_name="staging"} 1
# HELP spacelift_worker_pool_schedulable_runs_truncated Whether the search returned only some of the schedulable runs in a worker pool (1), so the by-state counts are partial, or all of them (0)
# TYPE spacelift_worker_pool_schedulable_runs_truncated gauge
spacelift_worker_pool_schedulable_runs_truncated{worker_pool_id="01HQZX9K7P2M3N4Q5R6S7T8U9V",worker_pool_name="production"} 1
spacelift_worker_pool_schedulable_runs_truncated{worker_pool_id="01HQZXA1B2C3D4E5F6G7H8J9K0",worker_pool_name="staging"} 0
# HELP spacelift_worker_pool_workers_by_status The number of workers in a worker pool by status: idle, busy, draining (drained and busy) or drained (drained and idle). draining plus drained normally equals spacelift_worker_pool_workers_drained (each from a separate request). busy plus draining equals spacelift_worker_pool_workers_busy when the API's busyWorkers count matches the workers' busy flags: that series comes from the pool's busyWorkers field and not from the worker list
# TYPE spacelift_worker_pool_workers_by_status gauge
spacelift_worker_pool_workers_by_status{status="busy",worker_pool_id="01HQZX9K7P2M3N4Q5R6S7T8U9V",worker_pool_name="production"} 3
spacelift_worker_pool_workers_by_status{status="busy",worker_pool_id="01HQZXA1B2C3D4E5F6G7H8J9K0",worker_pool_name="staging"} 1
spacelift_worker_pool_workers_by_status{status="drained",worker_pool_id="01HQZX9K7P2M3N4Q5R6S7T8U9V",worker_pool_name="production"} 1
spacelift_worker_pool_workers_by_status{status="drained",worker_pool_id="01HQZXA1B2C3D4E5F6G7H8J9K0",worker_pool_name="staging"} 0
spacelift_worker_pool_workers_by_status{status="draining",worker_pool_id="01HQZX9K7P2M3N4Q5R6S7T8U9V",worker_pool_name="production"} 1
spacelift_worker_pool_workers_by_status{status="draining",worker_pool_id="01HQZXA1B2C3D4E5F6G7H8J9K0",worker_pool_name="staging"} 0
spacelift_worker_pool_workers_by_status{status="idle",worker_pool_id="01HQZX9K7P2M3N4Q5R6S7T8U9V",worker_pool_name="production"} 1
spacelift_worker_pool_workers_by_status{status="idle",worker_pool_id="01HQZXA1B2C3D4E5F6G7H8J9K0",worker_pool_name="staging"} 2
